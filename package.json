{
  "name": "hospoda-reservations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:external": "node scripts/dev-local.mjs --external",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/verify-postgres.mjs --tests-only",
    "postinstall": "node scripts/generate-clients.mjs",
    "verify:c02": "node scripts/verify-c02.mjs",
    "verify:postgres": "node scripts/verify-postgres.mjs",
    "verify:docs": "node scripts/check-docs.mjs",
    "db:import-sqlite": "node scripts/migrate-local-sqlite.mjs",
    "prisma:generate": "node scripts/generate-clients.mjs",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "express": "4.19.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.5.4",
    "embedded-postgres": "16.14.0-beta.17",
    "pg": "8.23.1",
    "prisma": "5.20.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.1"
  }
}
